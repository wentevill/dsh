{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "./lib",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": false
  },
  "include": [
    "src/index.ts",
    "src/brand.ts",
    "src/commands.ts",
    "src/types.ts",
    "src/errors.ts",
    "src/domain.ts",
    "src/node-cron-runtime.ts",
    "src/runtime.ts",
    "src/state-machine.ts",
    "src/store.ts",
    "src/timezone.ts",
    "src/workspace.ts"
  ]
}
